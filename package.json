{
  "name": "farkle-friend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "analyze": "ANALYZE=true next build --webpack",
    "build": "next build",
    "preview": "node config/static-server.mjs out",
    "start": "npm run preview",
    "tokens": "node config/style-dictionary.mjs",
    "icon:tokens": "node src/scripts/generate-icons.mjs",
    "icons": "npm run icon:tokens && svg-sprite --config svg.json --log=info \"src/icons/*.svg\"",
    "audit:security": "npm audit --audit-level=high",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:static": "npm run build && STATIC_E2E=1 playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "prettier": "prettier --write \"src/**/*.{css,tsx,ts}\"",
    "format:check": "prettier --check \"src/**/*.{css,tsx,ts}\" \"tests/**/*.{ts,tsx}\" \"config/**/*.mjs\" \"*.{md,json,yml,ts,mjs}\" \".github/**/*.yml\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "next": "^16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.2.5",
    "@playwright/test": "^1.59.1",
    "@storybook/nextjs": "^10.1.3",
    "@storybook/react-vite": "^10.1.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-hook-form": "^7.67.0",
    "storybook": "^10.1.3",
    "style-dictionary": "^5.1.1",
    "svg-sprite": "^2.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.15",
    "zod": "^4.1.13"
  }
}
